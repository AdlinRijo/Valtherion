DISCORD_TOKEN=replace_with_your_discord_bot_token
WYNNCRAFT_API_TOKEN=replace_with_your_wynncraft_api_token

# Use the exact guild name and prefix shown by Wynncraft's public guild API.
GUILD_NAME=MY GUILD NAME
GUILD_TAG=MY GUILD TAG

# Hex RGB without a leading #.
ACCENT_COLOR=8B5CF6
SUCCESS_COLOR=2ECC71

# Use a persistent disk path on your host.
DATABASE_PATH=database/guild_history.sqlite3
